# Background (around the page)
set default-bg "#161718"

set guioptions ""
set window-title-basename true
set statusbar-h-padding 0
set statusbar-v-padding 0

# Page background and text
set recolor "true"
set recolor-lightcolor "#161718"   # page background
set recolor-darkcolor  "#dcdcdc"   # text color

# No custom recolour binding: zathura's built-in ctrl-r already toggles it.

# The font for the statusbar, the inputbar -- and the F link-hint numbers,
# which have no setting of their own. page-widget.c's set_font_from_property()
# parses this one string with pango and hands the family and size straight to
# cairo, always at bold weight. So enlarging the hint numbers means enlarging
# the bars too; they are the same setting and cannot be separated.
#
# "monospace" was the default here, and it is only a fontconfig alias: on this
# machine it resolves to Andale Mono (fc-match monospace). The bars go through
# pango and so honour that, but the hint numbers go through cairo's toy font
# API, which may or may not consult fontconfig depending on how cairo was
# built. Naming the real family removes the question, and matches alacritty.
set font "Hack Nerd Font 14"

# Statusbar, inputbar, etc.
set statusbar-bg "#2a2a2a"
set statusbar-fg "#eeeeee"

set inputbar-bg "#2a2a2a"
set inputbar-fg "#eeeeee"

set notification-bg "#2a2a2a"
set notification-fg "#eeeeee"

# Highlighting: search results, and the link hints F brings up. All three
# settings are shared between the two.
#
#   highlight-color         the box over each link / search hit
#   highlight-active-color  the current search result
#   highlight-fg            the hint NUMBER
#
# highlight-fg used to be unset, which left it at zathura's default of
# rgba(0,0,0,0.5) -- 50% black, over an opaque #444444 box, over a near-black
# page. That is why the numbers could not be seen at all.
#
# Why the box is dark, which is the whole trick. cairo_move_to is given
# (rectangle.x1 + 1, rectangle.y2 - 1): the number's baseline is pinned to the
# bottom-left corner of the link, which is exactly where the link's own first
# word sits. recolor renders that word in recolor-darkcolor, i.e. light. So the
# number is never drawn on the box alone -- it is drawn on the link's text,
# seen through the box. A light box made that light-on-light and the numbers
# were effectively invisible, which is what the first attempt here got wrong.
#
# A dark number does not rescue it either: a large number overflows upward out
# of the box onto the bare page, and dark-on-near-black is gone. Only a box
# dark enough to mask the text underneath, carrying a bright number, is legible
# in both places at once. Verified by reproducing this exact draw sequence
# offscreen with cairo rather than by eye.
#
# 0.85 and not 1.0 because these settings are shared with search: fully opaque
# leaves a search hit as a solid block with the matched word buried under it.
# At 0.85 the number still reads and the word is still there behind it.
#
# Tiers are the palette's own (sketchybar/colors.sh, alacritty.toml). Deep blue
# is what the bar already uses for the active workspace -- "the one you act on"
# -- which is what a hint is. Magenta is the alert tier, kept lighter because
# nothing is ever drawn on top of it.
set highlight-color        "rgba(26,95,180,0.85)"     # #1a5fb4  palette blue-deep
set highlight-active-color "rgba(252,94,240,0.55)"    # #fc5ef0  palette magenta
set highlight-fg           "rgba(245,255,167,1.0)"    # #f5ffa7  palette bright yellow

set selection-clipboard clipboard
