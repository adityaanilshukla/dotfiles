# Background (around the page)
set default-bg "#1e1e1e"

set guioptions ""
set window-title-basename true
set statusbar-h-padding 0
set statusbar-v-padding 0

# Page background and text
set recolor "true"
set recolor-lightcolor "#1e1e1e"   # page background
set recolor-darkcolor  "#dcdcdc"   # text color

# Toggle recolouring, for documents where inverting hurts more than it helps:
# scanned pages, figures, anything with real colour in it. zathura's own default
# for this is ctrl-r, which still works; this is added alongside.
#
# Written <A-D>, not <A-S-d>: zathura rejects stacked modifiers outright
# ("Invalid special key value or mode: A-S-d") and shift-d is simply D. The
# binding is alt-shift-d at the keyboard either way, and it is free in aerospace
# (alt-d is Raycast), so it reaches zathura instead of the window manager.
map <A-D> recolor

# Statusbar, inputbar, etc.
set statusbar-bg "#2a2a2a"
set statusbar-fg "#eeeeee"

set inputbar-bg "#2a2a2a"
set inputbar-fg "#eeeeee"

set notification-bg "#2a2a2a"
set notification-fg "#eeeeee"

# Highlighting (search results, links)
set highlight-color "#444444"
set highlight-active-color "#888888"
set selection-clipboard clipboard
