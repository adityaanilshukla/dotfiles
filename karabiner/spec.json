{
  "title": "dotfiles-managed keyboard remaps",
  "prefix": "dotfiles: ",

  "_notes": [
    "Source of truth for every Karabiner rule this repo owns. Edit this file,",
    "then run ./install.sh (or generate.py alone to refresh rules/managed.json).",
    "Never hand-edit rules/managed.json - it is generated.",
    "Never hand-edit ~/.config/karabiner/karabiner.json for anything defined",
    "here; the next install.sh run replaces it.",
    "",
    "prefix: every generated rule description starts with this. install.sh",
    "deletes all rules with this prefix before appending the current set, which",
    "is what makes re-running replace rather than duplicate, and what makes",
    "deleting a group here actually remove it. Rules you add by hand in the",
    "Karabiner GUI have no prefix and are left alone.",
    "",
    "scopes: named condition blocks referenced by each group's `scope`.",
    "  mode 'if'     = fire ONLY in the listed apps (allowlist)",
    "  mode 'unless' = fire EVERYWHERE EXCEPT the listed apps (denylist)",
    "  null          = no condition at all, fires everywhere",
    "Scoping cannot see inside an app: tmux inside Alacritty reads as Alacritty",
    "(good), and VS Code's integrated terminal reads as VS Code (less good - the",
    "letter remaps do apply in that pane).",
    "",
    "Find a bundle id with: osascript -e 'id of app \"AppName\"'",
    "or use Karabiner-EventViewer > Frontmost Application tab.",
    "",
    "Deliberately NOT mapped, because something else already owns the chord:",
    "  ctrl+shift+p  -> aerospace.toml opens a Brave incognito window",
    "  ctrl+shift+r  -> vscode/keybindings.json runs all notebook cells",
    "  ctrl+shift+x  -> aerospace.toml dismisses notifications",
    "Adding `optional: [\"shift\"]` to p or r would swallow those before the app",
    "ever sees them."
  ],

  "scopes": {
    "everywhere": null,

    "gui": {
      "mode": "unless",
      "bundle_identifiers": [
        "^com\\.apple\\.Terminal$",
        "^com\\.googlecode\\.iterm2$",
        "^io\\.alacritty$",
        "^org\\.alacritty$",
        "^net\\.kovidgoyal\\.kitty$",
        "^com\\.mitchellh\\.ghostty$",
        "^com\\.github\\.wez\\.wezterm$"
      ]
    },

    "browsers": {
      "mode": "if",
      "bundle_identifiers": [
        "^com\\.brave\\.Browser",
        "^com\\.google\\.Chrome",
        "^com\\.apple\\.Safari$",
        "^org\\.mozilla\\.firefox$"
      ]
    }
  },

  "default_scope": "gui",

  "groups": [
    {
      "description": "fn+F7/F8 volume down/up",
      "scope": "everywhere",
      "mappings": [
        { "from": "f7", "mods": ["fn"], "to": "volume_decrement" },
        { "from": "f8", "mods": ["fn"], "to": "volume_increment" }
      ]
    },

    {
      "description": "Ctrl+letter to Cmd+letter (not in terminals)",
      "scope": "gui",
      "mappings": [
        { "from": "c", "mods": ["control"], "optional": ["shift"], "to": "c", "to_mods": ["left_command"] },
        { "from": "v", "mods": ["control"], "optional": ["shift"], "to": "v", "to_mods": ["left_command"] },
        { "from": "x", "mods": ["control"], "to": "x", "to_mods": ["left_command"] },
        { "from": "z", "mods": ["control"], "optional": ["shift"], "to": "z", "to_mods": ["left_command"] },
        { "from": "y", "mods": ["control"], "to": "y", "to_mods": ["left_command"] },
        { "from": "a", "mods": ["control"], "to": "a", "to_mods": ["left_command"] },
        { "from": "f", "mods": ["control"], "to": "f", "to_mods": ["left_command"] },
        { "from": "g", "mods": ["control"], "to": "g", "to_mods": ["left_command"] },
        { "from": "s", "mods": ["control"], "to": "s", "to_mods": ["left_command"] },
        { "from": "p", "mods": ["control"], "to": "p", "to_mods": ["left_command"] },
        { "from": "t", "mods": ["control"], "optional": ["shift"], "to": "t", "to_mods": ["left_command"] },
        { "from": "w", "mods": ["control"], "optional": ["shift"], "to": "w", "to_mods": ["left_command"] },
        { "from": "n", "mods": ["control"], "optional": ["shift"], "to": "n", "to_mods": ["left_command"] },
        { "from": "r", "mods": ["control"], "to": "r", "to_mods": ["left_command"] }
      ]
    },

    {
      "description": "Ctrl+Left/Right word navigation (everywhere, terminals included)",
      "scope": "everywhere",
      "mappings": [
        { "from": "left_arrow", "mods": ["control"], "optional": ["shift"], "to": "left_arrow", "to_mods": ["left_option"] },
        { "from": "right_arrow", "mods": ["control"], "optional": ["shift"], "to": "right_arrow", "to_mods": ["left_option"] }
      ]
    },

    {
      "description": "Ctrl+Backspace/Delete deletes a word (everywhere)",
      "scope": "everywhere",
      "mappings": [
        { "from": "delete_or_backspace", "mods": ["control"], "to": "delete_or_backspace", "to_mods": ["left_option"] },
        { "from": "delete_forward", "mods": ["control"], "to": "delete_forward", "to_mods": ["left_option"] }
      ]
    },

    {
      "description": "Ctrl+Home/End jumps to document start/end",
      "scope": "gui",
      "mappings": [
        { "from": "home", "mods": ["control"], "optional": ["shift"], "to": "up_arrow", "to_mods": ["left_command"] },
        { "from": "end", "mods": ["control"], "optional": ["shift"], "to": "down_arrow", "to_mods": ["left_command"] }
      ]
    },

    {
      "description": "Ctrl+Tab cycles tabs",
      "scope": "gui",
      "mappings": [
        { "from": "tab", "mods": ["control"], "to": "right_arrow", "to_mods": ["left_command", "left_option"] },
        { "from": "tab", "mods": ["control", "shift"], "to": "left_arrow", "to_mods": ["left_command", "left_option"] }
      ]
    },

    {
      "description": "Ctrl+1..9 selects a tab",
      "scope": "gui",
      "mappings": [
        { "from": "1", "mods": ["control"], "to": "1", "to_mods": ["left_command"] },
        { "from": "2", "mods": ["control"], "to": "2", "to_mods": ["left_command"] },
        { "from": "3", "mods": ["control"], "to": "3", "to_mods": ["left_command"] },
        { "from": "4", "mods": ["control"], "to": "4", "to_mods": ["left_command"] },
        { "from": "5", "mods": ["control"], "to": "5", "to_mods": ["left_command"] },
        { "from": "6", "mods": ["control"], "to": "6", "to_mods": ["left_command"] },
        { "from": "7", "mods": ["control"], "to": "7", "to_mods": ["left_command"] },
        { "from": "8", "mods": ["control"], "to": "8", "to_mods": ["left_command"] },
        { "from": "9", "mods": ["control"], "to": "9", "to_mods": ["left_command"] }
      ]
    },

    {
      "description": "Ctrl+L address bar, Ctrl+Shift+I/J devtools (browsers only)",
      "scope": "browsers",
      "mappings": [
        { "from": "l", "mods": ["control"], "to": "l", "to_mods": ["left_command"] },
        { "from": "i", "mods": ["control", "shift"], "to": "i", "to_mods": ["left_command", "left_option"] },
        { "from": "j", "mods": ["control", "shift"], "to": "j", "to_mods": ["left_command", "left_option"] }
      ]
    }
  ]
}
