# --------------------
# Oh My Zsh basics
# --------------------
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="arrow"

zstyle ':omz:update' mode reminder
ENABLE_CORRECTION="true"

plugins=(git)

# source secrets if file exists
[[ -f ~/.secrets ]] && source ~/.secrets

# --------------------
# Homebrew completion path (macOS)
# --------------------
fpath+=("$(brew --prefix)/share/zsh/site-functions")

# --------------------
# Initialize oh-my-zsh
# --------------------
source "$ZSH/oh-my-zsh.sh"

# --------------------
# zsh-autosuggestions (Homebrew)
# --------------------
if [ -f "$(brew --prefix)/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]; then
  ZSH_AUTOSUGGEST_STRATEGY=(history completion)
  ZSH_AUTOSUGGEST_USE_ASYNC=true
  ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#888888'

  source "$(brew --prefix)/share/zsh-autosuggestions/zsh-autosuggestions.zsh"

  bindkey '^ ' autosuggest-accept   # Ctrl+Space
fi

# --------------------
# Aliases and environment
# --------------------
alias n='nvim'
alias c='clear'
alias rr='ranger'
alias f='fastfetch'
# quick note: open a timestamped scratch file in /tmp (cleared on reboot)
alias qn='nvim "/tmp/note_$(date +%Y-%m-%d_%H-%M-%S).txt"'
# career tracker: sync project repos and the tracker, regenerate the dashboard
alias tracker='~/Projects/Progress-tracker/scripts/tracker.sh'
alias mkenv='python3 -m venv .venv'
alias act='[ -d .venv ] && source .venv/bin/activate || echo "No .venv found"'
alias pipup='python -m pip install --upgrade pip'

export EDITOR="nvim"
export VISUAL="nvim"
export PAGER="less"

# macOS BSD ls uses -G instead of --color
alias ls="ls -G"
alias grep="grep --color=auto"
alias la="ls -A"
alias ll="ls -alF"
alias l="ls -CF"

export PATH="$HOME/.local/share/bob/nvim-bin:$PATH"
export PATH="$HOME/Scripts:$PATH"

# trash-cli is keg-only on Homebrew, so `brew install` never links it and the
# shell cannot see trash-put, trash-list, trash-restore or trash-empty. It is
# keg-only because macOS ships its own unrelated /usr/bin/trash and the two
# formulae collide on the name. Prepending the keg puts all six binaries on
# PATH, which also means trash-cli's `trash` now shadows /usr/bin/trash.
#
# That shadow is deliberate. The two write to different places: trash-cli uses
# the freedesktop location ~/.local/share/Trash, /usr/bin/trash uses the Finder
# trash at ~/.Trash. Everything else here is already on the trash-cli side,
# ranger's dT (rc.conf) and gT (which cds to ~/.local/share/Trash/files), so
# letting /usr/bin/trash win would mean `trash foo` put a file somewhere
# `trash-list` could not see. One trash, matching the Linux side on brovo.
#
# Reach the macOS one explicitly with /usr/bin/trash if you ever need Finder to
# show the file. Uses the opt path, not Cellar, so it survives version bumps.
export PATH="/opt/homebrew/opt/trash-cli/bin:$PATH"

# --------------------
# Ranger helper
# --------------------
rw() {
  tempfile="$(mktemp)"
  ranger --choosedir="$tempfile" "$@"
  if [ -f "$tempfile" ]; then
    dir="$(cat "$tempfile")"
    rm -f "$tempfile"
    [ -d "$dir" ] && cd "$dir"
  fi
}

# --------------------
# Keybinds (non-autosuggest)
# --------------------
# Ctrl+Left/Right word navigation used to be bound here as '^[[1;5C' and
# '^[[1;5D'. Removed as redundant, not as broken: oh-my-zsh's key-bindings.zsh
# already binds both, along with '^[[3;5~' (Ctrl+Delete) to kill-word and '^W'
# (which alacritty.toml sends for Ctrl+Backspace) to backward-kill-word. Check
# with: bindkey '^[[1;5C'
#
# Karabiner does NOT touch these in a terminal. It briefly did, rewriting
# Ctrl+Arrow to Option+Arrow everywhere, which broke them: alacritty leaves
# option_as_alt at None on macOS, so what arrived was a bare arrow key. Those
# groups are in the "gui" scope now, which excludes terminals.

# --------------------
# macOS nosleep (replaces systemd-inhibit)
# usage: nosleep 3600   # seconds
# --------------------
nosleep() {
  local dur="${1:-3600}"
  caffeinate -dimsu -t "$dur"
}

# --------------------
# History
# --------------------
HISTSIZE=10000
SAVEHIST=10000
HISTFILE="$HOME/.zsh_history"

# --------------------
# Completion settings
# --------------------
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'

# --------------------
# Extra compdefs
# --------------------
compdef _python java

# --------------------
# Dart completion (portable path)
# --------------------
[[ -f "$HOME/.dart-cli-completion/zsh-config.zsh" ]] && source "$HOME/.dart-cli-completion/zsh-config.zsh"

# --------------------
# zsh-syntax-highlighting (Homebrew) — MUST be last
# --------------------
if [ -f "$(brew --prefix)/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]; then
  source "$(brew --prefix)/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi

# Two zathuras can exist on a machine here, and which one is in front decides
# which plugin directory is even loadable.
#
#   ~/.local/zathura-gtk4   built from source, 2026.07.18, GTK4
#   /opt/homebrew/bin       the homebrew-zathura tap, 2026.02.09, GTK3
#
# The local build exists because GTK3's macOS backend re-uploads the whole
# viewport to the view on every frame, on the main thread, with no vsync pacing.
# That cost scales with window area, so fullscreen on a Retina display (~7.7M
# pixels a frame) jitters while a small window does not. Upstream's own answer
# was to move to GTK4 -- 2026.05.20 was the last GTK3 release -- and the tap has
# not moved in six months, so the newer one has to be built by hand. See
# BOOTSTRAP.md for the build.
#
# The two are NOT interchangeable as far as plugins go: the plugin ABI went 7 to
# 9 in that release, so the GTK4 binary refuses the tap's plugins by name
# ("Could not find 'zathura_plugin_8_9'") and vice versa. Hence one path or the
# other, never a merged list.
#
# Falls back to the brew build so a machine that has not been through the
# source build (ello, a fresh laptop) still opens PDFs.
if [[ -x "$HOME/.local/zathura-gtk4/bin/zathura" ]]; then
  export PATH="$HOME/.local/zathura-gtk4/bin:$PATH"
  # NOT an export of the same path. The GTK4 build has this exact directory
  # compiled in as its default, and zathura 2026.07.18 scans the env path IN
  # ADDITION to that default rather than instead of it. Setting it therefore
  # loads the one plugin twice: the first pass registers every filetype, the
  # second finds them all taken and ends with "Could not register plugin",
  # which library reads as a failed launch. The document had opened fine.
  #
  # Unset rather than merely not set, because an inherited value does the same
  # damage and tmux panes older than this change still carry one.
  unset ZATHURA_PLUGINS_PATH
else
# The tap installs each plugin into its own keg rather than a shared plugin
# directory, so the path has to be spelled out. Point at brew's `opt` symlinks,
# NOT at Cellar. This used to name the version (2026.02.03) directly, which
# works right up until `brew upgrade` moves the keg and zathura silently opens
# nothing -- there is no error, the plugin just is not there. `opt/<formula>`
# always points at whatever version is current.
#
# Order is not cosmetic: both plugins claim PDF, and the first one on this path
# wins -- the loser prints "filetype already registered" and is never used. So
# this line, not any setting in zathurarc, decides which renderer draws every
# PDF. mupdf goes first because poppler costs ~310ms a page here against mupdf's
# ~10ms, measured on a real book at the 2x scale a Retina display asks for.
#
# What that buys, precisely: page-boundary hitches, zoom, first display, and the
# Ctrl-r recolor toggle (which throws away every cached thumbnail in the
# document and rebuilds them on a single render thread). It does NOT buy smooth
# j/k scrolling within a page -- that path only re-blits an already-rendered
# surface and never reaches the plugin at all. Worth saying because the swap was
# originally made chasing exactly that symptom, and it did not fix it; the
# jitter was GTK3's macOS backend re-uploading the whole viewport per frame.
#
# The cost of putting mupdf first: poppler is now dead weight rather than a
# fallback. A plugin registers before it ever opens a file, so if mupdf drifts
# out of step with its library (see Brewfile) it still claims PDF and then
# refuses -- and nothing opens at all, rather than just epubs. `scripts/check-
# zathura-plugins` is what catches that; the fix is the rebuild it prints.
  export ZATHURA_PLUGINS_PATH="$(brew --prefix)/opt/zathura-pdf-mupdf:$(brew --prefix)/opt/zathura-pdf-poppler"
fi

# --------------------
# Lazy-load conda. The stock eager `conda init` block that used to sit here ran
# the hook on every shell: measured at ~0.23s of a ~0.37s startup, so roughly
# 60% of the time to open a terminal, for something most shells never use. The
# same fix landed on the Linux branch in 50ba6fc, where the hook cost ~1.7s.
#
# The cost is paid on first `conda` invocation instead: the function replaces
# itself with the real init, then re-runs the command transparently.
#
# NOTE: hand-rolled, not the stock block. Running `conda init` again will
# overwrite this with the eager version.
# --------------------
conda() {
    unset -f conda
    __conda_setup="$('/opt/homebrew/Caskroom/miniconda/base/bin/conda' 'shell.zsh' 'hook' 2> /dev/null)"
    if [ $? -eq 0 ]; then
        eval "$__conda_setup"
    else
        if [ -f "/opt/homebrew/Caskroom/miniconda/base/etc/profile.d/conda.sh" ]; then
            . "/opt/homebrew/Caskroom/miniconda/base/etc/profile.d/conda.sh"
        else
            export PATH="/opt/homebrew/Caskroom/miniconda/base/bin:$PATH"
        fi
    fi
    unset __conda_setup
    conda "$@"
}

# Installed scripts live here: t, zp, online-zathura. Conda no longer prepends
# to PATH at startup, but it still does on first use, and this must keep winning
# then too.
export PATH="$HOME/.local/bin:$PATH"

# --------------------
# Claude Code: two accounts, one Mac
# --------------------
# Personal and work are separate logins. They coexist because Claude Code names
# its Keychain entry after CLAUDE_CONFIG_DIR -- unset reads `Claude
# Code-credentials`, set reads `Claude Code-credentials-<sha256(dir)[0:8]>` --
# so both tokens sit in the Keychain at once and neither expires the other. Log
# into each once and switching is only ever this variable. scripts/claude-profile
# carries the detail.
#
# Personal is the unset case deliberately, so anything that does NOT come
# through this function -- a script, the VS Code extension, a cron job -- gets
# the personal account rather than no account.
#
# The prompt only appears when the answer is not already knowable. Resuming a
# session by id looks up which profile stores it, and --continue looks up which
# profile has history for this directory, because being asked there means being
# given the chance to answer wrong: session history is per-profile, so the wrong
# pick is an empty picker and a relaunch. See scripts/claude-profile.
claude() {
  # Launch normally when the resolver is not installed. This is the state of a
  # machine that has pulled this file -- ~/.zshrc is a symlink into the repo, so
  # that happens the moment `git pull` finishes -- but has not yet run
  # install.d/55-symlinks to put claude-profile on PATH. Without this branch the
  # function would return 1 on a missing command and the machine would have no
  # working `claude` at all until the installer was run, which is a bad trade
  # for a feature whose whole job is to be optional.
  if ! command -v claude-profile >/dev/null 2>&1; then
    command claude "$@"
    return
  fi

  local dir
  # No `local` on the same line as the assignment: that would swallow the exit
  # status and a cancelled prompt would launch Claude anyway.
  dir="$(claude-profile "$@")" || return 1
  if [[ -n "$dir" ]]; then
    CLAUDE_CONFIG_DIR="$dir" command claude "$@"
  else
    command claude "$@"
  fi
}
