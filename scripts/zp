#!/usr/bin/env bash

# Open a document in zathura without recording any reading state.
#
# zathura keys its state (page position, bookmarks) by absolute path in
# ~/.local/share/zathura/bookmarks.sqlite, and online-zathura pushes every new
# row in that file to Turso on the next synced launch. So merely skipping the
# wrapper does NOT keep a one-off document off the remote: the row still lands
# locally and gets uploaded later as an "add".
#
# This runs zathura against a throwaway data dir instead. Its bookmarks.sqlite
# is created inside a temp dir that is deleted when the window closes, the real
# database never gains a row, and the next synced launch has no delta to push.
# The config dir is untouched, so zathurarc theming still applies. Cost: no
# page-resume for this document, which is the point.
#
# Takes a path, so unlike library it works on files anywhere, not only the
# books under ~/Documents.

set -u

usage() {
  cat <<'EOF'
usage: zp FILE [FILE...]

zathura, privately. Open FILE with no reading state stored anywhere: no page
position, no bookmarks, nothing pushed to Turso. Relative paths are fine.

  -h, --help   show this message

For a synced read, where the page position is remembered and follows you
across machines, use `library` or `online-zathura` instead.
EOF
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  '')        usage >&2; exit 2 ;;
esac

for f in "$@"; do
  [[ -f "$f" ]] || { printf 'zp: no such file: %s\n' "$f" >&2; exit 1; }
done

# --- environment ---
# Usually run from an interactive shell, but library execs it too and a GUI
# launch inherits no environment, so resolve everything defensively.
# Prefer the locally built GTK4 zathura over the brew one. Resolved by path
# rather than left to `command -v`, because library execs this and a GUI launch
# inherits no PATH at all -- the fallback would silently pick the older GTK3
# build, which is the one that jitters at fullscreen. zsh/zshrc explains why
# there are two.
ZATHURA_GTK4="$HOME/.local/zathura-gtk4/bin/zathura"
if [[ -z "${ZATHURA:-}" && -x "$ZATHURA_GTK4" ]]; then
  ZATHURA="$ZATHURA_GTK4"
fi
ZATHURA="${ZATHURA:-$(command -v zathura || true)}"
ZATHURA="${ZATHURA:-/opt/homebrew/bin/zathura}"
[[ -x "$ZATHURA" ]] || { printf 'zp: zathura not found; set $ZATHURA\n' >&2; exit 1; }

# The plugin path has to match the binary, not merely be present: the plugin ABI
# went 7 to 9 between these two builds, so handing either one the other's
# directory gets every plugin rejected and an empty window. An inherited value
# is therefore not trustworthy on its own -- it is correct for whichever zathura
# the shell expected, which is not necessarily the one resolved above.
if [[ "$ZATHURA" == "$ZATHURA_GTK4" ]]; then
  # NOT an export of the same path. The GTK4 build has this exact directory
  # compiled in as its default, and zathura 2026.07.18 scans the env path IN
  # ADDITION to that default rather than instead of it. Setting it therefore
  # loads the one plugin twice: the first pass registers every filetype, the
  # second finds them all taken and ends with "Could not register plugin",
  # which library reads as a failed launch. The document had opened fine.
  #
  # Unset rather than merely not set, because an inherited value does the same
  # damage and tmux panes older than this change still carry one.
  unset ZATHURA_PLUGINS_PATH
elif [[ -z "${ZATHURA_PLUGINS_PATH:-}" || ! -d "${ZATHURA_PLUGINS_PATH%%:*}" ]]; then
  # Only pay for the cellar lookup when the inherited value is missing or stale;
  # zshrc hardcodes the plugin versions, which go wrong after a brew upgrade.
  if command -v brew >/dev/null 2>&1; then
    poppler="$(dirname "$(find "$(brew --cellar zathura-pdf-poppler 2>/dev/null)" -name 'libpdf-poppler.dylib' 2>/dev/null | head -n1)" 2>/dev/null)"
    mupdf="$(dirname "$(find "$(brew --cellar zathura-pdf-mupdf 2>/dev/null)" -name 'libpdf-mupdf.dylib' 2>/dev/null | head -n1)" 2>/dev/null)"
    # mupdf first: both plugins claim PDF, the first one here wins, and poppler
    # is slow enough on Retina to be felt at page boundaries, on zoom and on the
    # recolor toggle. zsh/zshrc carries the measurements and the trade-off.
    [[ -d "$poppler" && -d "$mupdf" ]] && export ZATHURA_PLUGINS_PATH="$mupdf:$poppler"
  fi
fi

# --- shared launch plumbing -------------------------------------------------
# Watching the log and handing the new window the keyboard is the same work in
# library, and used to be copy-pasted into both -- where it had already
# drifted. The sourced file explains what belongs in it and what does not.
ZATHURA_LAUNCH_LIB="${ZATHURA_LAUNCH_LIB:-$HOME/.local/lib/zathura-launch.sh}"
# shellcheck source=scripts/lib/zathura-launch.sh
if ! source "$ZATHURA_LAUNCH_LIB" 2>/dev/null; then
  printf 'zp: cannot load %s; re-run install.sh\n' "$ZATHURA_LAUNCH_LIB" >&2
  exit 1
fi

# Snapshot BEFORE the launch, or there is nothing for the new window-id to be
# larger than. Harmlessly 0 on a machine with no AeroSpace, where the watch
# loop skips focusing anyway and only reports a failed open.
before_max="$(zathura_max_id)"
LOG="$(zathura_log_init)"

# --- launch ---
TMPDATA=$(mktemp -d "${TMPDIR:-/tmp}"/zp.XXXXXX) || exit 1

# Detached, so the shell (or the alacritty window library runs in) is free
# immediately, and nohup keeps zathura alive when that terminal closes. The
# temp dir is removed by the same wrapper once zathura exits. Arguments are
# passed positionally so paths with spaces survive and the inner shell expands
# nothing of its own.
nohup bash -c 'bin=$1; dir=$2; shift 2; "$bin" --data-dir "$dir" "$@"; rm -rf "$dir"' \
  zp "$ZATHURA" "$TMPDATA" "$@" >"$LOG" 2>&1 &

# No linger: this runs in your own shell, where the message simply stays up.
zathura_watch zp "$LOG" "$before_max" || exit 1
