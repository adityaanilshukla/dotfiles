#!/usr/bin/env bash

# --- internal list mode -------------------------------------------------
# Used by the fzf picker below (initial load + Tab reload): print one row per
# book as "<display>\t<fullpath>", then exit before the slower zathura env
# setup. $2 is the display mode:
#   name  -> just the filename
#   path  -> the path relative to ~/Documents, so directories are searchable
# The full path is always the second (hidden) field, so selection is
# unambiguous even when two books share a filename.
if [[ "${1:-}" == "--list" ]]; then
  # The formats zathura can actually render here, which is what the two
  # installed plugins declare: poppler does application/pdf, and mupdf adds
  # epub, mobipocket, fictionbook and oxps. djvu used to be in this list and
  # was never openable: nothing registers image/vnd.djvu, so picking one got a
  # blank window rather than an error. Keep this in step with the `zp` rule in
  # ranger/rifle.conf, which gates on the same set.
  find "$HOME/Documents" \
    -type f \( -iname "*.pdf" -o -iname "*.epub" -o -iname "*.mobi" \
               -o -iname "*.fb2" -o -iname "*.oxps" \) \
    2>/dev/null | while IFS= read -r p; do
      if [[ "${2:-name}" == path ]]; then disp="${p#*/Documents/}"; else disp="${p##*/}"; fi
      printf '%s\t%s\n' "$disp" "$p"
    done
  exit 0
fi

# Absolute path to this script, so the fzf Tab-reload can re-invoke it.
SELF="$0"; [[ "$SELF" != /* ]] && SELF="$PWD/$SELF"

# --- arguments ---
# Default is a synced open through online-zathura. Private mode skips the
# wrapper *and* redirects zathura's data dir to a throwaway, because merely
# skipping the wrapper isn't enough: a row written into the real
# bookmarks.sqlite gets picked up as an "add" by the next synced launch's
# push. An optional FILE opens directly and skips the picker, which is the
# usual case for a one-off download that doesn't live under ~/Documents.
PRIVATE=0
BOOK_ARG=""

usage() {
  cat <<'EOF'
usage: library [-p|--private] [FILE]

  (no args)        fzf-pick a book under ~/Documents and open it synced
  -p, --private    open without sync: no reading state is stored anywhere
  FILE             open FILE directly instead of showing the picker

in the picker:
  enter            open synced
  ctrl-o           open private (no sync)
  tab              toggle between filename and path matching

The picker only lists books under ~/Documents. For anything else, `zp FILE`
opens it privately from any directory.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -p|--private) PRIVATE=1 ;;
    -h|--help)    usage; exit 0 ;;
    --)           shift; BOOK_ARG="${1:-}"; break ;;
    -*)           printf 'library: unknown option: %s\n' "$1" >&2; usage >&2; exit 2 ;;
    *)            BOOK_ARG="$1" ;;
  esac
  shift
done

# --- environment (important for GUI launches) ---
# GUI keybind invocations don't inherit a normal shell env, so we set up
# PATH (incl. ~/.local/bin for online-zathura), source the project-scoped
# Turso creds, and pin both binaries.
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
[[ -f "$HOME/.secrets" ]] && source "$HOME/.secrets"

# Overridable so the launch paths can be exercised with stub binaries; a GUI
# invocation has no environment, so the defaults are what actually run.
# Prefer the locally built GTK4 zathura; fall back to the brew GTK3 one on a
# machine that has not been through the source build. zsh/zshrc explains why
# there are two and why the plugin directories cannot be mixed.
ZATHURA_GTK4="$HOME/.local/zathura-gtk4/bin/zathura"
if [[ -z "${ZATHURA:-}" && -x "$ZATHURA_GTK4" ]]; then
  ZATHURA="$ZATHURA_GTK4"
fi
ZATHURA="${ZATHURA:-/opt/homebrew/bin/zathura}"
ONLINE_ZATHURA="${ONLINE_ZATHURA:-$HOME/.local/bin/online-zathura}"

# The plugin path must match the binary: the ABI went 7 to 9 between the two, so
# the wrong directory means every plugin is rejected and the window comes up
# empty. Resolved here rather than inherited, because a GUI launch arrives with
# no environment at all.
if [[ "$ZATHURA" == "$ZATHURA_GTK4" ]]; then
  # NOT an export of the same path. The GTK4 build has this exact directory
  # compiled in as its default, and zathura 2026.07.18 scans the env path IN
  # ADDITION to that default rather than instead of it. Setting it therefore
  # loads the one plugin twice: the first pass registers every filetype, the
  # second finds them all taken and ends with "Could not register plugin",
  # which library reads as a failed launch. The document had opened fine.
  #
  # Unset rather than merely not set, because an inherited value does the same
  # damage and tmux panes older than this change still carry one.
  unset ZATHURA_PLUGINS_PATH
else
  PDF_POPPLER="$(dirname "$(find "$(brew --cellar zathura-pdf-poppler)" -name 'libpdf-poppler.dylib' | head -n1)")"
  PDF_MUPDF="$(dirname "$(find "$(brew --cellar zathura-pdf-mupdf)" -name 'libpdf-mupdf.dylib' | head -n1)")"

  # mupdf first on purpose: both plugins claim PDF and the first one here wins.
  # poppler renders this machine's books at roughly 310ms a page against mupdf's
  # 10ms, which shows up at page boundaries, on zoom, and on the recolor toggle
  # -- not in j/k scrolling, which never reaches the plugin.
  export ZATHURA_PLUGINS_PATH="$PDF_MUPDF:$PDF_POPPLER"
fi

# --- book picker ---
# Skipped entirely when a FILE was given on the command line.
if [[ -n "$BOOK_ARG" ]]; then
  BOOK="$BOOK_ARG"
  [[ -f "$BOOK" ]] || { printf 'library: no such file: %s\n' "$BOOK" >&2; exit 1; }
else
  # The list shows each book's filename. Press Tab to switch the whole list to
  # show paths relative to ~/Documents instead, so you can fuzzy-match on a
  # directory too; Tab again switches back. A temp file holds the current mode so
  # the Tab reload knows which way to flip. --with-nth=1/--nth=1 keep the hidden
  # full-path field out of both the display and the search.
  MODE_FILE=$(mktemp)
  export MODE_FILE
  printf 'name\n' > "$MODE_FILE"

  # --private already chosen on the command line makes ctrl-o redundant, so the
  # header only advertises it in the default (synced) case.
  if (( PRIVATE )); then
    HEADER='private: nothing is synced   tab: toggle filename/path'
  else
    HEADER='enter: open synced   ctrl-o: open private   tab: toggle filename/path'
  fi

  # --expect makes fzf print the pressed key as its own first line before the
  # selected row, which is how ctrl-o gets distinguished from enter.
  SEL=$("$SELF" --list name | fzf \
    --delimiter='\t' --with-nth=1 --nth=1 \
    --expect=ctrl-o --header="$HEADER" \
    --bind 'tab:reload(m=$(cat "$MODE_FILE"); [ "$m" = name ] && m=path || m=name; printf "%s\n" "$m" > "$MODE_FILE"; '"$SELF"' --list "$m")')

  rm -f "$MODE_FILE"

  KEY="${SEL%%$'\n'*}"
  ROW="${SEL#*$'\n'}"
  # A cancelled fzf prints nothing, so KEY and ROW collapse to the same value.
  [[ "$ROW" == "$KEY" ]] && ROW=""
  # Nothing selected, so bail before launching anything.
  [[ "$ROW" != *$'\t'* ]] && exit 0

  # Recover the full path (the field after the tab).
  BOOK="${ROW#*$'\t'}"
  [[ "$KEY" == ctrl-o ]] && PRIVATE=1
fi

# --- private reads are handed off ---
# scripts/zp owns the throwaway-data-dir launch and its own focus handling, so
# there is one implementation of "read without syncing" and it is usable
# straight from a shell on any path, not just books under ~/Documents.
if (( PRIVATE )); then
  ZP="${ZP:-$HOME/.local/bin/zp}"
  [[ -x "$ZP" ]] || {
    printf 'library: %s missing; re-run install.sh\n' "$ZP" >&2
    exit 1
  }
  exec "$ZP" "$BOOK"
fi

# --- shared launch plumbing -------------------------------------------------
# Watching the log and handing the new window the keyboard is the same work in
# zp, and used to be copy-pasted into both -- where it had already drifted. The
# sourced file explains what belongs in it and what deliberately does not.
ZATHURA_LAUNCH_LIB="${ZATHURA_LAUNCH_LIB:-$HOME/.local/lib/zathura-launch.sh}"
# shellcheck source=scripts/lib/zathura-launch.sh
if ! source "$ZATHURA_LAUNCH_LIB" 2>/dev/null; then
  printf 'library: cannot load %s; re-run install.sh\n' "$ZATHURA_LAUNCH_LIB" >&2
  exit 1
fi

# Snapshot BEFORE the launch, or there is nothing for the new window-id to be
# larger than.
before_max="$(zathura_max_id)"
LOG="$(zathura_log_init)"

# --- launch ---
# Route through online-zathura: it pulls reading state from Turso, execs real
# zathura (via ZATHURA_BINARY), and pushes deltas back when you close the
# window. nohup+& detaches the whole wrapper so alacritty can close.
ZATHURA_BINARY="$ZATHURA" nohup "$ONLINE_ZATHURA" "$BOOK" >"$LOG" 2>&1 &

# Linger 8 seconds on an error. This runs in an alacritty window that closes on
# its own the moment the script returns, so the message has to outlive it.
zathura_watch library "$LOG" "$before_max" 8 || exit 1
