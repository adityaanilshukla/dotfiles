#!/usr/bin/env bash

# Night Shift toggle, the ~/Scripts entry that the alt-x launcher lists. The
# Linux script of this name drives redshift and owns a state file; here the
# work is done by the nightlight CLI (smudge/smudge/nightlight), which is
# already in the Brewfile and talks to CoreBrightness directly. No UI appears
# and nothing is launched.
#
# Two things about the name, which is deliberately the same as the CLI's:
#
#   1. ~/Scripts comes before /opt/homebrew/bin on PATH (zsh/zshrc), so this
#      file shadows the binary it wraps. That is harmless only because it
#      forwards every argument, so `nightlight status`, `nightlight temp 40`
#      and the rest still behave exactly as the CLI documents.
#   2. The absolute path below is mandatory. A bare `nightlight` here would
#      find this script again and recurse.
#
# Called with no arguments, which is what the launcher does, the CLI toggles.

CLI=/opt/homebrew/bin/nightlight

# How warm Night Shift goes, on the CLI's 0-100 scale. The CLI's own default is
# 50, which is the weaker end and is what a machine gets if nothing sets it;
# 100 is the warmest it offers. Overridable for a one-off without editing this.
TEMP="${NIGHTLIGHT_TEMP:-100}"

# Bootstrap on a fresh machine can reach the symlinks before the tap is
# installed. Say so rather than closing the launcher window on a blank error.
if [ ! -x "$CLI" ]; then
  printf 'nightlight: %s missing; re-run install.sh\n' "$CLI" >&2
  sleep 3
  exit 1
fi

# Apply the warmth before switching on, so turning it on always lands at TEMP
# rather than at whatever the CLI last stored. Only the two forms that switch
# it on are treated this way: an explicit `temp` call is the user setting the
# value themselves, and `status`/`off` have no business changing anything.
case "${1:-}" in
  ''|on) "$CLI" temp "$TEMP" >/dev/null 2>&1 || true ;;
esac

exec "$CLI" "$@"
