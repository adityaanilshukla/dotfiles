#!/usr/bin/env bash
#
# Set alacritty's font size to suit whichever screen is attached.
#
# The MacBook's own screen wants a smaller number than the ultrawide does, and
# the gap is large enough that the wrong one is unusable rather than merely
# annoying. Before this existed the fix was Ctrl+= about seventeen times per
# terminal, and the zoom died with the window.
#
# How the pieces fit:
#
#   this script            picks a size and writes ~/.config/alacritty/font-size.toml
#   alacritty.toml         imports that file and deliberately sets no size itself
#   alacritty              live-reloads the import, in every open window, ~2s
#   sketchybar             runs this on its display_change event
#
# Nothing polls and nothing new runs in the background. Run it by hand after
# changing the two sizes below; it is on PATH as alacritty-font-size.

set -uo pipefail

# The two numbers, and the only opinions in this file. Everything else is
# measured at runtime, so plugging in a different monitor needs no new entry.
#
# 20.0 is what the config carried for years and suits the built-in display.
# 28.5 was arrived at empirically: it is the size the ultrawide was being
# hand-zoomed to, recovered by measuring a window at 1720px wide showing 101
# columns, so a 17px cell, which alacritty produces at exactly 28.5.
#
# Note these are NOT in the ratio that keeps text physically the same size on
# both screens; that would put the ultrawide near 23. It sits further away, so
# it wants more. No formula recovers that, which is why they are written down.
SIZE_BUILTIN=20.0
SIZE_EXTERNAL=28.5

OUT="$HOME/.config/alacritty/font-size.toml"

# Full paths throughout. sketchybar runs under launchd with PATH=/usr/bin:/bin,
# so a bare `swift` would not resolve. Same trap as ranger's dT and the LSP
# servers nvim could not spawn; see ranger/README.md.
SWIFT=/usr/bin/swift

# Locate display-info.swift next to this script, following the ~/.local/bin
# symlink that install.sh creates.
SELF="$0"
[ -L "$SELF" ] && SELF="$(/usr/bin/readlink "$SELF")"
PROBE="$(cd "$(dirname "$SELF")" && pwd -P)/display-info.swift"

log() { [ -n "${ALACRITTY_FONT_SIZE_VERBOSE:-}" ] && printf '%s\n' "$*" >&2; return 0; }

# --- pick a size ---
# Any display at scale 1 means an ordinary-density external monitor is
# attached, and that is the screen being worked on, whether or not the lid is
# also open. A MacBook's built-in panel is always scale 2. So: external
# present -> the big size; nothing but Retina -> the small one.
#
# The deliberate choice here is lid-open-while-docked, where both screens are
# live and one font size has to cover both. It resolves to the monitor. Flip
# the comparison if the laptop screen should win instead.
SIZE=""
if [ -x "$SWIFT" ] && [ -f "$PROBE" ]; then
  while IFS=$'\t' read -r scale ppi name; do
    [ -z "${scale:-}" ] && continue
    log "display: $name  scale=$scale  ${ppi} PPI"
    case "$scale" in
      0.*|1.*) SIZE="$SIZE_EXTERNAL" ;;                    # scale 1, ordinary density
      *)       [ -z "$SIZE" ] && SIZE="$SIZE_BUILTIN" ;;   # Retina, unless an external already won
    esac
  done < <("$SWIFT" "$PROBE" 2>/dev/null)
fi

# Probe unavailable or silent (no Command Line Tools, display asleep mid-switch).
# Leave a good file alone rather than guessing over it; only invent a value when
# there is nothing at all, and then assume the laptop on its own, which is the
# state a machine boots into.
if [ -z "$SIZE" ]; then
  if [ -s "$OUT" ]; then
    log "probe gave nothing; keeping $OUT as is"
    exit 0
  fi
  log "probe gave nothing and no file yet; assuming the built-in display"
  SIZE="$SIZE_BUILTIN"
fi

# --- write it, only if it changed ---
# The guard is not just to avoid noise. Alacritty reloads on every write, and a
# reload is what would stomp a font size someone had deliberately zoomed to in
# one window, so a spurious event must not turn into a write.
NEW="# Generated by scripts/alacritty-font-size. Edits here are overwritten.
[font]
size = $SIZE"

if [ -f "$OUT" ] && [ "$(cat "$OUT")" = "$NEW" ]; then
  log "already $SIZE, nothing written"
  exit 0
fi

# Via a temp file in the same directory, so alacritty's watcher never reads a
# half-written TOML.
mkdir -p "$(dirname "$OUT")"
TMP="$(mktemp "$OUT.XXXXXX")" || exit 1
printf '%s\n' "$NEW" >"$TMP" && mv -f "$TMP" "$OUT" || { rm -f "$TMP"; exit 1; }
log "font size -> $SIZE"
