#!/usr/bin/env bash
#
# Launch the apps people reach you on, hidden, at login.
#
# Why this exists: sketchybar's unread item can only report what an app
# publishes, and an app that is not running publishes nothing. Telegram is the
# sharp case — it has no aps-environment entitlement, so while it is quit it
# receives no pushes at all and there is no trace of the message anywhere. The
# bar shows that as ":off", but showing it is not the same as fixing it.
#
# A LaunchAgent rather than a macOS Login Item on purpose. Login Items can only
# be added by scripting System Events, which needs an Automation grant that
# cannot be scripted, so it could never be part of a hands-off install. A
# LaunchAgent is a file, which means install.sh can just place it.
#
# `open -g -j`: -g leaves focus where it is, -j starts the app hidden. Together
# they mean login finishes with the apps connected and silent rather than with
# three windows stealing the screen.
#
# Already-running apps are skipped rather than re-opened, so running this by
# hand is harmless.

APPS=(
  "WhatsApp"
  "Telegram"
  "Zoho Mail - Desktop"
)

for app in "${APPS[@]}"; do
  # -x would miss "Zoho Mail - Desktop", whose process name differs from the
  # bundle name, so match on the app bundle path instead.
  if pgrep -f "/Applications/${app}.app/Contents/MacOS/" >/dev/null 2>&1; then
    continue
  fi
  [ -d "/Applications/${app}.app" ] || continue
  open -g -j -a "$app" 2>/dev/null || true
done
