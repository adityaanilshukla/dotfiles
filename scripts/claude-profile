#!/usr/bin/env bash
#
# Decide which Claude Code profile a `claude` invocation should use, and print
# that profile's CLAUDE_CONFIG_DIR on stdout. Prints nothing for the personal
# profile, which is the stock ~/.claude and wants no variable set at all.
#
# Called by the `claude` wrapper function in zsh/zshrc. Split out into a script
# rather than written inline there because it is fifty lines of logic with real
# failure modes, and because a bash script can be shellchecked.
#
# WHY A SECOND CONFIG DIR IS ENOUGH TO HOLD A SECOND ACCOUNT
#
# Claude Code names its Keychain entry after the config directory. From the
# binary (2.1.236), reformatted:
#
#   let suffix = CLAUDE_CONFIG_DIR ? "-" + sha256(configDir).slice(0,8) : ""
#   return `Claude Code${OAUTH_FILE_SUFFIX}-credentials${suffix}`
#
# So an unset variable reads `Claude Code-credentials` and a set one reads
# `Claude Code-credentials-<8 hex>`. The two logins sit side by side in the
# Keychain and neither expires the other: log into each once, ever, and
# switching afterwards is only this variable. That is the whole reason this
# approach is painless rather than a /logout dance.
#
# WHAT ELSE MOVES WITH IT
#
# Everything: settings.json, hooks, permissions, MCP servers, plugins, skills,
# memory, and session history. Isolation is the point, but it does mean the
# work profile needs claude/install.sh run against it too, or it has no sudo
# guard. install.d/75-claude.sh does that.
#
# Prints the directory, never a message, on stdout. Anything for a human goes
# to /dev/tty so it cannot end up inside the variable.

set -euo pipefail

WORK_DIR="$HOME/.claude-work"
PERSONAL_DIR="$HOME/.claude"

# Personal is the unset case, so it is what a bare `claude` gets anywhere this
# wrapper is not in play -- a script, an IDE extension, a cron job. Printing
# nothing is therefore not "no answer", it is the answer.
personal() { exit 0; }
work()     { printf '%s\n' "$WORK_DIR"; exit 0; }

# Nothing to choose between until the work profile exists. Keeps this inert on
# a machine that has not been set up (ello, a fresh laptop) instead of
# prompting for a profile that is not there.
[[ -d "$WORK_DIR" ]] || personal

# An explicit request wins over everything below, including the resume lookup.
case "${CLAUDE_PROFILE:-}" in
  work)     work ;;
  personal) personal ;;
  '')       ;;
  *) printf 'claude-profile: unknown CLAUDE_PROFILE %q (want work or personal)\n' \
       "$CLAUDE_PROFILE" >/dev/tty 2>/dev/null || true ;;
esac

# --- what kind of invocation is this? ---
# Only -r/--resume with an actual session id can be resolved without asking; a
# bare -r opens the picker, which is per-profile and so still needs a choice.
UUID_RE='^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$'
resume_id=""
continuing=0
printing=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    -r|--resume)
      # The next argument is optional and may be a search term rather than an
      # id, so only take it when it actually looks like one.
      if [[ -n "${2:-}" && "$2" =~ $UUID_RE ]]; then resume_id="$2"; shift; fi
      ;;
    --session-id)
      [[ -n "${2:-}" ]] && shift
      ;;
    -c|--continue)   continuing=1 ;;
    -p|--print)      printing=1 ;;
  esac
  shift
done

# --- resolve without asking, where that is possible ---

# Which config dirs hold a transcript matching $1 (a glob under projects/)?
# Prints one directory per line.
owners() {
  local pattern="$1" dir
  for dir in "$PERSONAL_DIR" "$WORK_DIR"; do
    [[ -d "$dir/projects" ]] || continue
    # -print -quit: the first hit settles it, no need to walk the rest.
    if [[ -n "$(find "$dir/projects" -name "$pattern" -print -quit 2>/dev/null)" ]]; then
      printf '%s\n' "$dir"
    fi
  done
}

if [[ -n "$resume_id" ]]; then
  # Resuming a named session: whichever profile stores it is by definition the
  # right one, and asking could only produce a wrong answer.
  found="$(owners "$resume_id.jsonl")"
  case "$(printf '%s' "$found" | grep -c .)" in
    1) if [[ "$found" == "$WORK_DIR" ]]; then work; else personal; fi ;;
    *) ;;   # 0 = unknown id, 2 = impossible but not worth dying over. Ask.
  esac
fi

if (( continuing )); then
  # --continue means "the most recent session in this directory", so the
  # question is which profiles have ever been used in this directory. The
  # encoding replaces every non-alphanumeric character with a dash:
  # /Users/aditya/dotfiles -> -Users-aditya-dotfiles
  encoded="$(printf '%s' "$PWD" | sed 's/[^a-zA-Z0-9]/-/g')"
  found=""
  for d in "$PERSONAL_DIR" "$WORK_DIR"; do
    if compgen -G "$d/projects/$encoded/*.jsonl" >/dev/null 2>&1; then
      found="${found}${d}"$'\n'
    fi
  done
  case "$(printf '%s' "$found" | grep -c .)" in
    1) if [[ "$found" == *"$WORK_DIR"* ]]; then work; else personal; fi ;;
    *) ;;   # 0 = never used here, 2 = used from both. Ask.
  esac
fi

# --- otherwise, ask ---

# Never prompt where there is no one to answer: -p, a pipe, a script, an
# editor integration. Blocking on a keypress that cannot arrive would hang the
# invocation outright, which is a far worse failure than picking a default.
if (( printing )) || [[ ! -t 0 || ! -r /dev/tty ]]; then
  personal
fi

printf 'claude profile — [p]ersonal  [w]ork ? ' > /dev/tty
# -s so the keypress is not echoed twice, -n1 so it needs no Enter.
read -r -s -n1 key < /dev/tty || { printf '\n' > /dev/tty; exit 1; }

case "$key" in
  w|W) printf 'work\n'     > /dev/tty; work ;;
  p|P) printf 'personal\n' > /dev/tty; personal ;;
  *)   printf '\ncancelled\n' > /dev/tty; exit 1 ;;
esac
