#!/usr/bin/env bash
#
# Centre the focused window on its monitor.
#
# Exists because AeroSpace cannot do it. `aerospace move` takes a direction and
# walks the tiling tree, so on a floating window it has nothing to act on and
# the window does not budge -- which is exactly when centring is wanted, since a
# tiled window is already placed. There is no `center` subcommand in 0.21.3.
#
# So the placement is done through the Accessibility API instead, the same one
# AeroSpace itself drives. Requires whatever runs this to hold Accessibility
# permission; from a keybinding that is AeroSpace, which already has it.
#
# Only the focused window is touched, and only its position -- never its size,
# never another window, never a workspace. Run it while looking at the window.
# A window on a hidden workspace is parked far off-screen by AeroSpace and
# moving it there achieves nothing: the position is overwritten when the
# workspace is shown again.
set -euo pipefail

# Everything this prints is mirrored to a log, because the way it is normally
# run throws output away. AeroSpace exec-and-forget keeps neither stdout nor
# stderr, so a keypress that fails does so in complete silence and leaves
# nothing to read afterwards -- which is exactly how the first version of this
# presented: pressed, nothing moved, no error anywhere.
#
# tee rather than a plain redirect so a run by hand still prints to the terminal.
LOG="${XDG_CACHE_HOME:-$HOME/.cache}/center-window.log"
mkdir -p "$(dirname "$LOG")"
exec > >(tee -a "$LOG") 2>&1
printf -- '--- %s\n' "$(date '+%Y-%m-%d %H:%M:%S')"

# PATH is not hardened here on purpose: `aerospace list-exec-env-vars` shows
# exec-and-forget already runs with /opt/homebrew/bin on PATH, so this resolves.
command -v aerospace >/dev/null 2>&1 || { printf 'center-window: needs aerospace\n' >&2; exit 1; }

read -r pid layout <<<"$(aerospace list-windows --focused --format '%{app-pid} %{window-layout}' 2>/dev/null)"
monitor="$(aerospace list-monitors --focused --format '%{monitor-name}' 2>/dev/null)"
[[ -n "${pid:-}" ]] || { printf 'center-window: no focused window\n' >&2; exit 1; }

# A tiled window cannot be centred: AeroSpace owns its position and puts it
# straight back, so setting one is a silent no-op -- which is exactly how this
# script first appeared to be broken. Float it instead of doing nothing.
#
# Doing that rather than refusing, because for the window this was written for
# the two are the same request. scrcpy is aspect-locked: tiled, it is handed the
# full width of its slot, clamps itself to a phone shape and sits against the
# left edge of the space it was given. Nothing about it is movable until it
# leaves the tiles, so "centre this" can only mean "float it and centre it".
#
# Reversible with the same alt-shift-space that would have floated it by hand.
if [[ "${layout:-}" != "floating" ]]; then
  aerospace layout floating || {
    printf 'center-window: could not float the window\n' >&2; exit 1; }
  printf 'center-window: was %s, floated it first\n' "${layout:-tiled}" >&2
fi

# The top gap is AeroSpace's, not the system's. On this setup the menu bar is
# auto-hidden, so NSScreen reports visibleFrame == frame and knows nothing about
# the 37px strip held open for sketchybar -- centring against the raw frame
# would push the window up under the bar.
#
# Read from the config file rather than from `aerospace config --get
# gaps.outer.top`, which answers "No value at key token 'gaps'" in 0.21.3.
# The setting is per monitor and looks like:
#
#   outer.top = [{ monitor.'built-in Retina Display' = 5 }, { monitor.'DELL ...' = 37 }, 37]
#
# so take this monitor's entry, and fall back to the bare trailing default when
# the monitor is not named.
#
# THREE outcomes, and they must never collapse into one. A gap of 0 is a
# CONCLUSION reached here, never a fallback landed in:
#
#   no config, or no outer.top   -> AeroSpace applies no top gap. 0 is correct.
#   outer.top read               -> use what it says.
#   outer.top there, unreadable  -> the gap is UNKNOWN. Refuse.
#
# The third case used to also produce 0, and that is exactly what made the BSD
# sed bug below present as a centring bug instead of a parsing one: the window
# came out a bar-height too high, tucked under sketchybar, and the script
# exited 0 reporting nothing wrong. Guessing buys nothing -- a wrong gap
# misplaces the window just as surely as not running at all, and costs an
# afternoon working out which of the two happened.
CONF="$HOME/.config/aerospace/aerospace.toml"
gap=0

if [[ -e "$CONF" && ! -r "$CONF" ]]; then
  printf 'center-window: %s exists but cannot be read\n' "$CONF" >&2
  exit 1
fi

if [[ ! -r "$CONF" ]]; then
  printf 'center-window: no config at %s, assuming no top gap\n' "$CONF" >&2
elif ! line="$(grep -m1 '^outer\.top' "$CONF")"; then
  printf 'center-window: no outer.top in %s, assuming no top gap\n' "$CONF" >&2
else
  # Compared in lowercase because AeroSpace compares these case-insensitively.
  # The config says `built-in Retina Display` and the monitor is really called
  # `Built-in Retina Display`: AeroSpace matches that pair and uses 5, so
  # anything reading this file has to agree or it silently takes the fallback
  # 37 instead and places every window 32px out.
  #
  # sed -E throughout: this runs against BSD sed, where \+ is a literal plus
  # and every one of these matched nothing.
  lc() { tr '[:upper:]' '[:lower:]'; }
  monitor_lc="$(printf '%s' "$monitor" | lc)"
  line_lc="$(printf '%s' "$line" | lc)"
  gap="$(sed -nE "s/.*monitor\.'${monitor_lc}' *= *([0-9]+).*/\1/p" <<<"$line_lc")"
  [[ -n "$gap" ]] || gap="$(sed -nE 's/.*, *([0-9]+) *\].*/\1/p' <<<"$line_lc")"
  # And the plain form, `outer.top = 37`, which the two patterns above both
  # miss -- they need a monitor clause or a closing bracket.
  [[ -n "$gap" ]] || gap="$(sed -nE 's/^outer\.top *= *([0-9]+) *$/\1/p' <<<"$line_lc")"
  [[ -n "$gap" ]] || {
    printf 'center-window: could not read a top gap out of %s\n' "$CONF" >&2
    printf '  line:    %s\n' "$line" >&2
    printf '  monitor: %s\n' "$monitor" >&2
    printf '  Refusing rather than assuming 0 -- a wrong gap hides the window\n' >&2
    printf '  under sketchybar and looks like a centring bug.\n' >&2
    exit 1
  }
fi

# Geometry and placement together, so the window is measured and moved without a
# round trip in between that it could move during.
#
# Screen picked by which frame contains the window's centre, so this stays
# correct if a second monitor is ever attached. NSScreen is bottom-left origin
# with y up; the Accessibility API is top-left origin with y down, and its
# origin is the TOP of the primary screen -- hence flipping against the primary
# screen's height rather than against the window's own screen.
# stderr deliberately NOT suppressed. It was, and that made a failure look
# exactly like a success: the script exited 0, printed nothing, and the window
# stayed where it was.
osascript -l JavaScript - "$pid" "$gap" <<'JXA'
ObjC.import("AppKit");
function run(argv) {
  var pid = parseInt(argv[0], 10), gap = parseInt(argv[1], 10);
  var se = Application("System Events");
  var proc = se.processes.whose({ unixId: pid })[0];
  // windows[0], not the AeroSpace-focused window. AeroSpace identifies windows
  // by its own window-id, which has no mapping to an Accessibility window
  // index, so for an app holding several windows this centres its frontmost
  // one rather than necessarily the focused one. Correct for the single-window
  // case this is used in; worth knowing before pressing it in a browser.
  var win = proc.windows[0];
  var pos = win.position(), size = win.size();
  var cx = pos[0] + size[0] / 2, cy = pos[1] + size[1] / 2;

  var screens = $.NSScreen.screens.js;
  var primaryTop = screens[0].frame.origin.y + screens[0].frame.size.height;

  // frame decides WHICH screen the window is on; visibleFrame decides where it
  // may be placed on it. The two differ, and using frame for both is wrong in a
  // way that only shows on one display: this MacBook reports frame 1470x956 and
  // visibleFrame 1470x924, the 32px belonging to the notch, while the external
  // DELL reports them identical. AeroSpace itself lays out against visibleFrame
  // plus the gap -- a tiled window here sits at 32 + 37 = 69, which is what
  // confirmed it. Centring against frame put everything 32px high on the laptop
  // and was exactly right on the monitor, which is the kind of bug that gets
  // called "works fine" for months.
  function axRect(r) {
    return { x: r.origin.x, y: primaryTop - (r.origin.y + r.size.height),
             w: r.size.width, h: r.size.height };
  }

  var target = null;
  for (var i = 0; i < screens.length; i++) {
    var f = axRect(screens[i].frame);
    if (cx >= f.x && cx < f.x + f.w && cy >= f.y && cy < f.y + f.h) {
      target = axRect(screens[i].visibleFrame); break;
    }
  }
  if (target === null) target = axRect(screens[0].visibleFrame);

  var usableTop = target.y + gap, usableH = target.h - gap;
  var nx = Math.round(target.x + (target.w - size[0]) / 2);
  var ny = Math.round(usableTop + (usableH - size[1]) / 2);
  if (nx < target.x) nx = target.x;
  if (ny < usableTop) ny = usableTop;

  win.position = [nx, ny];
  return [pos[0], pos[1], size[0], size[1], nx, ny].join(" ");
}
JXA
