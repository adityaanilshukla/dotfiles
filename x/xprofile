export PATH="$HOME/.local/bin:$PATH"
export QT_QPA_PLATFORMTHEME=qt5ct
export DESKTOP_SESSION=i3

# Force the dark Adwaita VARIANT for GTK3 apps.
#
# Deliberately the env var rather than a setting, because on GTK 3.24.52 nothing
# else works. Tested on buffyx, ALL of these rendered a light dialog:
#   settings.ini  gtk-theme-name=Adwaita + gtk-application-prefer-dark-theme=true
#   settings.ini  gtk-theme-name=Adwaita-dark
#   settings.ini  gtk-theme-name=AdwaitaDark
#   dconf         gtk-theme=Adwaita-dark
# and only GTK_THEME=Adwaita:dark rendered dark.
#
# Why: 3.24.4x replaced Adwaita with a port of libadwaita's stylesheet, which
# ignores gtk-application-prefer-dark-theme. "Adwaita-dark" is not a name GTK3
# resolves, and the AdwaitaDark package on disk is not a working GTK3 dark
# stylesheet. "Adwaita:dark" is theme:variant syntax, which still works.
#
# It also outranks XSETTINGS, which matters on brovo where xsettingsd publishes
# Net/ThemeName "Adwaita" and overrides settings.ini entirely.
#
# Fixes: zenity-gtk3 dialogs and the browser file chooser (via
# xdg-desktop-portal-gtk) rendering light on a dark desktop. GTK4/libadwaita
# apps were never affected -- they follow color-scheme=prefer-dark instead.
export GTK_THEME=Adwaita:dark

# ...and push it into the D-Bus/systemd activation environment.
#
# Exporting above only covers processes started FROM this session. D-Bus- and
# systemd-activated services inherit the systemd user environment instead, which
# is seeded from /etc/environment -- and on buffyx that file carries an old
# GTK_THEME=Adwaita-dark (hyphen), a name GTK3 does not resolve, so it silently
# falls back to light. brovo has no such line and was unaffected.
#
# The visible symptom was Firefox's file chooser being light while every other
# GTK3 app was dark: that dialog is not drawn by Firefox, it is drawn by
# xdg-desktop-portal-gtk, an activated service.
#
# Fix /etc/environment too if you have root (setup-gtk.sh warns about it), but
# this line makes the session correct regardless.
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
  dbus-update-activation-environment --systemd GTK_THEME
fi
[[ -f ~/.Xresources ]] && xrdb -merge ~/.Xresources
